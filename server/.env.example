# Puerto del API
PORT=4000

# Origen(es) permitido(s) para CORS, separados por coma
CORS_ORIGIN=http://localhost:5180

# Postgres de Supabase.
# Se recomienda el "Session pooler" (funciona sobre IPv4, gratis) salvo que el
# host donde corre Dokploy tenga IPv6 real — en ese caso puede usarse la
# conexión "Direct" en su lugar. NO usar el "Transaction pooler" (puerto 6543):
# este API corre como proceso persistente, no como funciones serverless.
# Se obtiene en: Supabase Dashboard > Connect > Direct > "Session pooler"
# Formato: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres"

# Supabase Dashboard > Project Settings > API Keys
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Nota: no se necesita SUPABASE_JWT_SECRET. El middleware de auth verifica el
# access_token vía `supabaseAdmin.auth.getUser()`, que funciona sin importar si
# el proyecto firma con el JWT Secret legacy (HS256) o con las nuevas Signing
# Keys asimétricas (ECC P-256) — no hay que decodificar el JWT a mano.
